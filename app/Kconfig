# Source base Zephyr Kconfig tree
source "$(ZEPHYR_BASE)/Kconfig"

# Source out-of-tree LED sensor driver Kconfig
rsource "../drivers/sensor/led_sensor/Kconfig"

menu "Application Configuration"

menuconfig LED_SUBSYSTEM
bool "LED Subsystem"
default y
help
  Enable the LED subsystem configuration options.

choice LED_BLINK_SLEEP_TIME
prompt "LED blink sleep time"
depends on LED_SUBSYSTEM
default LED_BLINK_SLEEP_TIME_1S

config LED_BLINK_SLEEP_TIME_250MS
bool "250 ms"

config LED_BLINK_SLEEP_TIME_500MS
bool "500 ms"

config LED_BLINK_SLEEP_TIME_1S
bool "1 second"

config LED_BLINK_SLEEP_TIME_2S
bool "2 seconds"
endchoice

config APP_HEARTBEAT_PERIOD_MS
int
default 250 if LED_BLINK_SLEEP_TIME_250MS
default 500 if LED_BLINK_SLEEP_TIME_500MS
default 1000 if LED_BLINK_SLEEP_TIME_1S
default 2000 if LED_BLINK_SLEEP_TIME_2S

config LED_BRIGHTNESS
int "LED brightness (%)"
depends on LED_SUBSYSTEM
default 50
range 0 100
help
  Brightness percentage for the LED (0 to 100).

config LED_FADE_DURATION
int "LED fade duration (ms)"
depends on LED_SUBSYSTEM
default 1000
range 0 5000
help
  Duration of the LED fade cycle in milliseconds (0 to 5000 ms).

menuconfig ADVANCED_LED_SETTINGS
bool "Advanced LED settings"
depends on LED_SUBSYSTEM
help
  Enable advanced configuration options for LEDs.

menu "Expert settings"
visible if ADVANCED_LED_SETTINGS

config LED_DEBUG
bool "Enable LED debugging"
help
  Enable debug logs and features for the LED driver.

config LED_CUSTOM_BLINK_PATTERN
bool "Enable custom blink pattern"
help
  Enable custom programmable blinking sequences.
endmenu

endmenu
